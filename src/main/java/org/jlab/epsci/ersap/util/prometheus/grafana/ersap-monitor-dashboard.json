  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": false,
          "text": "ersap",
          "value": "ersap"
        },
        "description": "The --metric-prefix the exporter was started with, without the trailing underscore.",
        "hide": 0,
        "label": "Metric prefix",
        "name": "prefix",
        "options": [
          {
            "selected": true,
            "text": "ersap",
            "value": "ersap"
          }
        ],
        "query": "ersap",
        "skipUrlSync": false,
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "metrics(${prefix}_.*)",
        "description": "Every Monitor FE metric the exporter has published so far. Discovered from Prometheus itself, so engine metrics added later appear here without editing the dashboard.",
        "hide": 0,
        "includeAll": true,
        "label": "Metric",
        "multi": true,
        "name": "metric",
        "options": [],
        "query": "metrics(${prefix}_.*)",
        "refresh": 2,
        "regex": "/^(?!.*prometheus_exporter).*$/",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values({__name__=~\"${prefix}_.+\"},host)",
        "hide": 0,
        "includeAll": true,
        "label": "Host",
        "multi": true,
        "name": "host",
        "options": [],
        "query": "label_values({__name__=~\"${prefix}_.+\"},host)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
